--- a/src/plugins/janus_audiocall.c
+++ b/src/plugins/janus_audiocall.c
@@ -420,6 +420,7 @@ typedef struct janus_audiocall_session {
 	char *remote_username;		/* Username of our partner on the peer server */
 	gboolean remote_video_seen;	/* Got the first video packet from the peer (keyframe requested) */
 	struct sockaddr_in remote_addr;	/* Link address of the server our partner is on */
+	struct sockaddr_in media_addr;	/* IC: where this call's media is sent/accepted: the relay if configured, else remote_addr */
 	char *remote_server;		/* Name of that server */
 	janus_mutex mutex;
 	janus_refcount ref;
@@ -523,6 +524,11 @@ static gboolean link_enabled = FALSE;
 static char *link_server_name = NULL;
 static uint16_t link_local_port = JANUS_AUDIOCALL_DEFAULT_LINK_PORT, link_ws_port = 8188;
 static char *link_public_host = NULL;	/* address apps use to reach this server (public_host), or NULL */
+/* IC: optional media relay. When set, cross-server call media is sent to (and only
+ * accepted from) this address instead of the peer server directly. Signaling is
+ * unaffected and still goes straight to the peer. */
+static struct sockaddr_in link_media_relay;
+static gboolean link_media_relay_set = FALSE;
 static int link_fd = -1;
 static GThread *link_thread = NULL;
 static volatile gint link_dirty = 0;			/* our users changed: announce now */
@@ -709,6 +715,8 @@ static void janus_audiocall_remote_add(janus_audiocall_session *session, guint32
 	session->call_id = call_id;
 	session->remote_video_seen = FALSE;
 	session->remote_addr = *remote_addr;
+	/* IC: this call's media goes via the relay if one is configured, else straight to the peer */
+	session->media_addr = link_media_relay_set ? link_media_relay : *remote_addr;
