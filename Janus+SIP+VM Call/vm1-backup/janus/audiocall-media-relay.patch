+		item = janus_config_get(config, config_general, janus_config_type_item, "media_relay_host");
+		if(item != NULL && item->value != NULL && strlen(item->value) > 0) {
+			uint16_t mrport = JANUS_AUDIOCALL_DEFAULT_LINK_PORT;
+			janus_config_item *pitem = janus_config_get(config, config_general, janus_config_type_item, "media_relay_port");
+			if(pitem != NULL && pitem->value != NULL && janus_string_to_uint16(pitem->value, &mrport) < 0)
+				JANUS_LOG(LOG_WARN, "[AudioCall] Invalid media_relay_port '%s', using %d\n", pitem->value, mrport);
