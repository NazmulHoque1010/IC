+				janus_audiocall_link_send_rtp(&session->media_addr, call_id, FALSE, packet->buffer, packet->length);
 #endif
 			return;
 		}
@@ -1766,7 +1793,7 @@ void janus_audiocall_incoming_rtcp(janus_plugin_session *handle, janus_plugin_rt
 					janus_rtcp_has_fir(packet->buffer, packet->length))) {
