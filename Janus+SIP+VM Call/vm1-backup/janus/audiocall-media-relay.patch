+				JANUS_LOG(LOG_INFO, "[AudioCall] Media relay enabled: cross-server call media via %s:%u\n", item->value, mrport);
+			} else {
+				JANUS_LOG(LOG_WARN, "[AudioCall] Invalid media_relay_host '%s', media relay disabled\n", item->value);
+			}
+		}
