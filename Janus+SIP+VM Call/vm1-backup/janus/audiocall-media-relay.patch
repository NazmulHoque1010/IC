-				/* Not from the server this call is with (or the call is ending): drop it */
+				/* Not from the media source this call uses (or the call is ending): drop it */
 				janus_refcount_decrease(&session->ref);
 				continue;
 			}
@@ -1319,6 +1327,25 @@ int janus_audiocall_init(janus_callbacks *callback, const char *config_path) {
 		item = janus_config_get(config, config_general, janus_config_type_item, "public_host");
 		if(item != NULL && item->value != NULL && strlen(item->value) > 0)
 			link_public_host = g_strdup(item->value);
+		/* IC: optional media relay (media_relay_host / media_relay_port). When set, this
+		 * server forwards all cross-server call media to that address, and only accepts
