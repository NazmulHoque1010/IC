<profile name="phones">
  <aliases></aliases>
  <gateways></gateways>
  <domains></domains>
  <settings>
    <param name="context" value="public"/>
    <param name="dialplan" value="XML"/>
    <param name="sip-ip" value="$${ic_self_ip}"/>
    <param name="sip-port" value="5090"/>
    <param name="rtp-ip" value="$${ic_self_ip}"/>
    <param name="ext-sip-ip" value="$${ic_public_ip}"/>
    <param name="ext-rtp-ip" value="$${ic_public_ip}"/>
    <param name="local-network-acl" value="ic_nolocal"/>
    <param name="auth-calls" value="true"/>
    <param name="force-register-domain" value="$${domain}"/>
    <param name="force-subscription-domain" value="$${domain}"/>
    <param name="force-register-db-domain" value="$${domain}"/>
    <param name="challenge-realm" value="auto_from"/>
    <param name="multiple-registrations" value="false"/>
    <param name="aggressive-nat-detection" value="true"/>
    <param name="NDLB-received-in-nat-reg-contact" value="true"/>
    <param name="NDLB-force-rport" value="true"/>
    <param name="nat-options-ping" value="true"/>
    <param name="ping-mean-interval" value="5"/>
    <param name="timer-T1X64" value="4000"/>
    <param name="unregister-on-options-fail" value="true"/>
    <param name="sip-force-expires" value="300"/>
    <param name="apply-nat-acl" value="nat.auto"/>
    <param name="manage-presence" value="false"/>
    <param name="inbound-codec-prefs" value="$${ic_phone_codec}"/>
    <param name="outbound-codec-prefs" value="$${ic_phone_codec}"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="inbound-late-negotiation" value="true"/>
    <param name="rtp-timer-name" value="soft"/>
    <param name="dtmf-type" value="rfc2833"/>
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    <param name="user-agent-string" value="IC"/>
    <param name="log-auth-failures" value="true"/>
  </settings>
</profile>
